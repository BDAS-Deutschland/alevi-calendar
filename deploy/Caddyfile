# Caddy config for kalender.bdas.de (copy of the blocks in /opt/meta-dashboard/deploy/Caddyfile).
# 'root' is the path inside the Caddy container; /srv/alevi-kalender is mounted there.

(alevi_files) {
	# short URLs; the original file names keep working
	rewrite /abo-de /alevi-de.ics
	rewrite /abo-tr /alevi-tr.ics
	rewrite /abo-en /alevi-en.ics
	rewrite /abo /alevi.ics
	# download buttons: force a file download (the HTML download attribute is ignored on other sites)
	@dl path_regexp dl ^/download(-de|-tr|-en)?$
	header @dl Content-Disposition "attachment; filename=\"alevi-kalender{re.dl.1}.ics\""
	rewrite @dl /alevi{re.dl.1}.ics
	rewrite /widget.js /alevi-calendar.js
	rewrite /embed /embed.html
	root * /srv/alevi
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors *"
		Access-Control-Allow-Origin "*"
		# no-cache = browser re-checks via ETag on every load (cheap 304), so updates show up immediately
		Cache-Control "no-cache"
	}
	@ics path *.ics
	header @ics Content-Type "text/calendar; charset=utf-8"
	file_server {
		hide .htaccess _headers
	}
}

kalender.bdas.de {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	import alevi_files
}
